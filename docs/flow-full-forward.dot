// the star-wing and background pipeline, visit level to cleaned coadd
// render: dot -Tpdf docs/flow-full-forward.dot -o flow-full-forward.pdf
//         dot -Tpng -Gdpi=110 docs/flow-full-forward.dot -o flow-full-forward.png
digraph starsub {
    rankdir = TB;
    fontname = "Helvetica";
    node [shape=box, style="rounded,filled", fontname="Helvetica",
          fontsize=11, fillcolor="#f4f4f4", color="#666666"];
    edge [fontname="Helvetica", fontsize=9, color="#444444"];

    // ------------------------------------------------------------
    subgraph cluster_inputs {
        label = "Butler inputs (DP2 or weekly)";
        style = "rounded";
        color = "#999999";
        fontsize = 12;
        node [fillcolor="#e8eef8"];
        prelim [label="preliminary_visit_image\n(ADU) + its calibration"];
        bg [label="preliminary_visit_image_background\nlayer 0: 6x6 Chebyshev fit\nlayers 1+: pedestals"];
        skycorr [label="skyCorr\n(focal-plane sky model)"];
        meta [label="calibrateImage_metadata\nadaptive_threshold_value"];
        vsum [label="visit_summary\nwcs, bbox, calibration"];
        coadd [label="deep_coadd cell coadd\n(none state: polynomials\nsubtracted, object bg restored)\nper-cell inputs and weights"];
        gaia [label="Gaia DR3 refcat\nper-tract and per-visit extracts"];
    }

    // ------------------------------------------------------------
    subgraph cluster_tmpl {
        label = "A. Wing calibration (once per band)";
        style = "rounded";
        color = "#7a9a5a";
        fontsize = 12;
        node [fillcolor="#eaf3df"];
        extract [label="per detector, all 180 of a visit:\nrestore polynomial, wide-box sky pass,\ntemplate-star stamps (G 15.5-17.5),\nwing profiles on the warp state\n(G < 15.5, to 2500 px)\n[lsst-starsub-visit-template --extract-only]"];
        pool [label="pool per visit: median stack,\njoint two-power-law fit to stack (10-50 px)\nand flux-normalized cloud (40-2500 px),\nzero point k_in\n[--from-extracts]"];
        canon [label="canonical wing per band:\nmedian over visits of k_in T(r)\n(nJy per unit Gaia flux;\n8-14 percent visit scatter at 50-300 px)"];
        extract -> pool -> canon;
    }

    // ------------------------------------------------------------
    subgraph cluster_resp {
        label = "B. Polynomial response (once per visit-detector)";
        style = "rounded";
        color = "#b0743a";
        fontsize = 12;
        node [fillcolor="#f8ecdc"];
        raw [label="raw sky image =\npreliminary image + stored background"];
        maskr [label="rebuild the mask the fit saw:\nfirst-pass 50-sigma detections dilated 10 px,\nstar-background detection at the stored\nadaptive threshold grown 70 psf sigma"];
        render [label="render census wings (G < 16)\nfrom the canonical wing"];
        resp [label="response = fit(raw) - fit(raw - stars)\n(star_background config: 128 px bins,\nMEANCLIP, weighted 6x6 Chebyshev);\norder-2 surface removed; stored coarse\n[lsst_starsub.trough.ResponseCache]"];
        raw -> maskr -> resp;
        render -> resp;
    }

    // ------------------------------------------------------------
    subgraph cluster_coadd {
        label = "C. Trough correction (per patch)";
        style = "rounded";
        color = "#5a7aa8";
        fontsize = 12;
        node [fillcolor="#e2e9f4"];
        rcoadd [label="R: per cell, weighted mean of the inputs'\nresponses with the coadd's own weights\n[lsst-starsub-cell-forward]"];
        forward [label="forward state = none + R\nstars on a smooth sky, trough removed"];
        rcoadd -> forward;
    }

    // ------------------------------------------------------------
    subgraph cluster_clean {
        label = "D. Star subtraction and sky (per patch, lsst_mdet machinery)";
        style = "rounded";
        color = "#8a5a9a";
        fontsize = 12;
        node [fillcolor="#efe3f3"];
        census [label="Gaia census, star masks,\nwide exclusion zones"];
        sky1 [label="round 1: 256 px sky pass,\nstars excluded to their\ntemplate extents"];
        tmplc [label="template from the coadd's own stamps\n+ aureole from mid-bright stars;\nanchor-ring amplitudes, joint solve"];
        sky2 [label="round 2: re-add stars, 64 px sky pass,\nrefit amplitudes; final 64 px sky\non the star-free image"];
        resid [label="residual: star-free, sky-flat coadd\n[lsst-starsub-cell-clean]"];
        census -> sky1 -> tmplc -> sky2 -> resid;
    }

    // ------------------------------------------------------------
    subgraph cluster_valid {
        label = "Validation";
        style = "rounded,dashed";
        color = "#999999";
        fontsize = 12;
        node [fillcolor="#ffffff", style="rounded,filled,dashed"];
        v1 [label="dual-state stacks:\nobject / none / restored / forward\naround census stars"];
        v2 [label="restored - none vs forward - none\nas images (no pixel noise):\nbright stars agree to 10-30 percent"];
        v3 [label="residual profiles by input route\n(none / restored / forward)"];
        v4 [label="metadetection: injection test,\nstar-galaxy correlations"];
        v1 -> v2 -> v3 -> v4 [style=invis];
    }

    // ------------------------------------------------------------
    // the data flow between stages
    prelim -> extract;
    bg -> extract;
    skycorr -> extract [label="warp state\n(no detector-scale sky fit)"];
    gaia -> extract;
    gaia -> render;
    prelim -> raw;
    bg -> raw;
    meta -> maskr;
    vsum -> rcoadd [label="geometry"];
    canon -> render;
    coadd -> rcoadd [label="inputs, weights"];
    resp -> rcoadd;
    coadd -> forward [label="none"];
    forward -> census;
    gaia -> census;
    resid -> v4;
    forward -> v1;
    resp -> v2;
    resid -> v3;

    // the alternative that was tried first
    restore [label="statistical restoration:\nnone + per-cell weighted mean of the\nstored polynomials (order-2 removed)\n[lsst-starsub-cell-restore]", fillcolor="#f0f0f0", style="rounded,filled,dashed"];
    bg -> restore [style=dashed];
    coadd -> restore [style=dashed];
    restore -> v2 [style=dashed, label="reference"];
}
